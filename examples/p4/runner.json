{
  "version": 2,
  "provider": {
    "endpoint": "http://127.0.0.1:9000/v1/chat/completions",
    "model": "controlled-demo",
    "evidence": "test-double"
  },
  "capture": "required",
  "limits": {
    "context_bytes": 32000,
    "file_bytes": 2000000,
    "recipe_seconds": 120,
    "elapsed_seconds": 600
  },
  "recipes": {
    "build": {
      "kind": "build",
      "argv": [
        "/ABSOLUTE/PATH/TO/dotnet",
        "build",
        "Project.csproj",
        "-m:1",
        "-p:UseSharedCompilation=false"
      ],
      "result": {
        "format": "exit",
        "path": ""
      },
      "rerun_safe": true,
      "env": {}
    }
  }
}
